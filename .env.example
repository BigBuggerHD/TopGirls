# ── Top Girls – Umgebungsvariablen (Beispiel) ──
# Kopiere diese Datei nach .env und passe die Werte an.

# PostgreSQL
DATABASE_URL="postgresql://topgirls:topgirls@localhost:5432/topgirls?schema=public"

# Öffentliche Basis-URL (ohne Slash am Ende)
APP_URL="http://localhost:3000"

# Geheimnisse (mind. 32 zufällige Zeichen, z. B. `openssl rand -hex 32`)
SESSION_SECRET="bitte-aendern-mindestens-32-zeichen-lang-xxxxxxxx"
AGE_GATE_SECRET="bitte-aendern-mindestens-32-zeichen-lang-yyyyyyyy"

# Dauer der Altersbestätigung in Stunden
AGE_GATE_TTL_HOURS="24"

# ── Speicher ──
# local = Dateisystem (nur Entwicklung), s3 = S3-kompatibler Speicher
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ── E-Mail ── (leer = E-Mails werden nur in der Konsole ausgegeben)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Top Girls <no-reply@example.com>"

# ── SMS (Bestätigung der Telefonnummer) ──
# leer = Codes werden in der Entwicklung nur im Terminal ausgegeben.
# Ein echter Anbieter ist noch nicht angebunden (siehe src/lib/sms.ts).
SMS_PROVIDER=""

# ── Zahlungen ──
# Sandbox-Zahlungsanbieter für lokale Tests (in Produktion: false)
PAYMENT_SANDBOX="true"
PAYMENT_SANDBOX_SECRET="sandbox-webhook-secret-bitte-aendern"

# PayPal REST API (https://developer.paypal.com) – leer = deaktiviert
PAYPAL_MODE="sandbox"          # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Kreditkarte – Adapter vorbereitet, Zahlungsdienstleister noch nicht integriert
CREDITCARD_PROVIDER=""
CREDITCARD_API_KEY=""
CREDITCARD_WEBHOOK_SECRET=""

# Nextcoup – Adapter vorbereitet, Schnittstelle noch nicht integriert
NEXTCOUP_API_BASE=""
NEXTCOUP_MERCHANT_ID=""
NEXTCOUP_API_KEY=""
NEXTCOUP_WEBHOOK_SECRET=""
