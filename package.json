{
  "name": "top-girls",
  "version": "1.0.0",
  "private": true,
  "description": "Top Girls – Premium-Anzeigenportal",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
